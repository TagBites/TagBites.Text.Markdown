<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TagBites</RootNamespace>
  </PropertyGroup>

  <!-- Build -->
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Package info -->
  <PropertyGroup>
    <Description>Builds Markdown documents in .NET from a typed element tree. Renders CommonMark with GitHub Flavored Markdown extensions.</Description>
    <PackageTags>markdown; markdig; commonmark; gfm; builder; generator; documentation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://tagbites.com/markdown/</PackageProjectUrl>
  </PropertyGroup>

</Project>
